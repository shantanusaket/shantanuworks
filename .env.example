# ───────── REQUIRED ─────────
NEXT_PUBLIC_SITE_URL=https://www.shantanuworks.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET – server only. Never prefix with NEXT_PUBLIC_. Never share.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma separated emails allowed into /admin (also add them in Supabase Auth)
ADMIN_EMAILS=you@example.com

# ───────── CONTACT (public details shown on the site) ─────────
NEXT_PUBLIC_PHONE=+918210328847
NEXT_PUBLIC_WHATSAPP=918210328847
NEXT_PUBLIC_CONTACT_EMAIL=sdgviewads@gmail.com
NEXT_PUBLIC_SDGVIEW_URL=https://www.sdgview.com

# ───────── OPTIONAL: AUTOMATION ─────────
# Email automation (https://resend.com) – lead alerts to you + auto-reply to client
RESEND_API_KEY=
EMAIL_FROM=ShantanuWorks <hello@shantanuworks.com>
NOTIFY_EMAIL=you@example.com

# AI Guruji (https://console.anthropic.com). Without a key Guruji still answers from your Knowledge Base.
ANTHROPIC_API_KEY=
GURUJI_MODEL=claude-sonnet-5-5

# Verification tokens (Google Search Console / Bing) – optional
NEXT_PUBLIC_GSC_VERIFICATION=
